rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function schoolPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId);
    }

    function academicClassPath(schoolId, classId) {
      return /databases/$(database)/documents/schools/$(schoolId)/classes/$(classId);
    }

    function academicSubjectPath(schoolId, subjectId) {
      return /databases/$(database)/documents/schools/$(schoolId)/subjects/$(subjectId);
    }

    function academicClassSubjectPath(schoolId, mappingId) {
      return /databases/$(database)/documents/schools/$(schoolId)/classSubjects/$(mappingId);
    }

    function questionPath(schoolId, questionId) {
      return /databases/$(database)/documents/schools/$(schoolId)/questions/$(questionId);
    }

    function questionSharePath(schoolId, shareId) {
      return /databases/$(database)/documents/schools/$(schoolId)/questionShares/$(shareId);
    }

    function invitationPath(invitationId) {
      return /databases/$(database)/documents/invitations/$(invitationId);
    }

    function joinRequestPath(schoolId, userId) {
      return /databases/$(database)/documents/schools/$(schoolId)/joinRequests/$(userId);
    }

    function currentUserExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function hasAuthEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0;
    }

    function hasVerifiedAuthEmail() {
      return hasAuthEmail()
        && request.auth.token.email_verified == true;
    }

    function isGoogleAuthProvider() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function hasVerifiedOrGoogleAuthEmail() {
      return hasAuthEmail()
        && (request.auth.token.email_verified == true || isGoogleAuthProvider());
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isActiveRole(role) {
      return currentUserExists()
        && currentUser().role == role
        && currentUser().status == "active";
    }

    function isActivePlatformAdmin() {
      return isActiveRole("platform_admin");
    }

    function isActiveSchoolAdmin() {
      return isActiveRole("school_admin");
    }

    function isActiveTeacher() {
      return isActiveRole("teacher");
    }

    function isAcademicSetupReader(schoolId) {
      return isOwnSchool(schoolId)
        || (isActiveTeacher() && currentUser().schoolId == schoolId);
    }

    function validSchoolStatus(status) {
      return status in ["active", "inactive"];
    }

    function validAcademicStatus(status) {
      return status in ["active", "inactive"];
    }

    function isValidAcademicCode(code) {
      return code is string
        && code.size() > 0
        && code.matches("^[A-Z0-9][A-Z0-9_-]*$");
    }

    function isValidAcademicItemPayload(data) {
      return data.name is string
        && data.name.size() > 0
        && isValidAcademicCode(data.code)
        && validAcademicStatus(data.status);
    }

    function isValidAcademicItemCreate(schoolId) {
      return isOwnSchool(schoolId)
        && request.resource.data.keys().hasAll([
          "name",
          "code",
          "status",
          "createdAt",
          "updatedAt",
          "createdBy"
        ])
        && request.resource.data.keys().hasOnly([
          "name",
          "code",
          "status",
          "createdAt",
          "updatedAt",
          "createdBy"
        ])
        && isValidAcademicItemPayload(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAcademicItemUpdate(schoolId) {
      return isOwnSchool(schoolId)
        && request.resource.data.keys().hasAll([
          "name",
          "code",
          "status",
          "createdAt",
          "updatedAt",
          "createdBy"
        ])
        && request.resource.data.keys().hasOnly([
          "name",
          "code",
          "status",
          "createdAt",
          "updatedAt",
          "createdBy"
        ])
        && isValidAcademicItemPayload(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "code",
          "status",
          "updatedAt"
        ]);
    }

    function isActiveAcademicClass(schoolId, classId) {
      return exists(academicClassPath(schoolId, classId))
        && get(academicClassPath(schoolId, classId)).data.status == "active";
    }

    function isActiveAcademicSubject(schoolId, subjectId) {
      return exists(academicSubjectPath(schoolId, subjectId))
        && get(academicSubjectPath(schoolId, subjectId)).data.status == "active";
    }

    function isValidClassSubjectMappingPayload(data) {
      return data.classId is string
        && data.classId.size() > 0
        && data.subjectId is string
        && data.subjectId.size() > 0;
    }

    function classSubjectMappingId(classId, subjectId) {
      return classId + "__" + subjectId;
    }

    function isValidClassSubjectMappingCreate(schoolId, mappingId) {
      return isOwnSchool(schoolId)
        && request.resource.data.keys().hasAll([
          "classId",
          "subjectId",
          "createdAt",
          "createdBy"
        ])
        && request.resource.data.keys().hasOnly([
          "classId",
          "subjectId",
          "createdAt",
          "createdBy"
        ])
        && isValidClassSubjectMappingPayload(request.resource.data)
        && mappingId == classSubjectMappingId(
          request.resource.data.classId,
          request.resource.data.subjectId
        )
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isActiveAcademicClass(schoolId, request.resource.data.classId)
        && isActiveAcademicSubject(schoolId, request.resource.data.subjectId);
    }

    function isTeacherProfileInSchool(schoolId, teacherId) {
      return existsAfter(userPath(teacherId))
        && getAfter(userPath(teacherId)).data.schoolId == schoolId
        && getAfter(userPath(teacherId)).data.role == "teacher"
        && getAfter(userPath(teacherId)).data.status == "active";
    }

    function isMappedClassSubject(schoolId, classId, subjectId) {
      return exists(academicClassSubjectPath(
          schoolId,
          classSubjectMappingId(classId, subjectId)
        ))
        && get(academicClassSubjectPath(
          schoolId,
          classSubjectMappingId(classId, subjectId)
        )).data.classId == classId
        && get(academicClassSubjectPath(
          schoolId,
          classSubjectMappingId(classId, subjectId)
        )).data.subjectId == subjectId
        && (
          !get(academicClassSubjectPath(
            schoolId,
            classSubjectMappingId(classId, subjectId)
          )).data.keys().hasAny(["status"])
          || get(academicClassSubjectPath(
            schoolId,
            classSubjectMappingId(classId, subjectId)
          )).data.status == "active"
        );
    }

    function teacherAssignmentId(teacherId, classId, subjectId) {
      return teacherId + "__" + classId + "__" + subjectId;
    }

    function isTeacherAssignmentReader(schoolId) {
      return isOwnSchool(schoolId)
        || (
          isActiveTeacher()
          && currentUser().schoolId == schoolId
          && resource.data.teacherId == request.auth.uid
        );
    }

    function isValidTeacherAssignmentPayload(data) {
      return data.teacherId is string
        && data.teacherId.size() > 0
        && data.classId is string
        && data.classId.size() > 0
        && data.subjectId is string
        && data.subjectId.size() > 0
        && data.status == "active";
    }

    function isValidTeacherAssignmentCreate(schoolId, assignmentId) {
      return isOwnSchool(schoolId)
        && request.resource.data.keys().hasAll([
          "teacherId",
          "classId",
          "subjectId",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "teacherId",
          "classId",
          "subjectId",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && isValidTeacherAssignmentPayload(request.resource.data)
        && assignmentId == teacherAssignmentId(
          request.resource.data.teacherId,
          request.resource.data.classId,
          request.resource.data.subjectId
        )
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isTeacherProfileInSchool(schoolId, request.resource.data.teacherId)
        && isActiveAcademicClass(schoolId, request.resource.data.classId)
        && isActiveAcademicSubject(schoolId, request.resource.data.subjectId)
        && isMappedClassSubject(
          schoolId,
          request.resource.data.classId,
          request.resource.data.subjectId
        );
    }

    function teacherAssignmentPath(schoolId, teacherId, classId, subjectId) {
      return /databases/$(database)/documents/schools/$(schoolId)/teacherAssignments/$(teacherAssignmentId(teacherId, classId, subjectId));
    }

    function validQuestionDifficulty(difficulty) {
      return difficulty in ["easy", "medium", "hard"];
    }

    function isTeacherAssignedToQuestionSubject(schoolId, classId, subjectId) {
      return exists(teacherAssignmentPath(
          schoolId,
          request.auth.uid,
          classId,
          subjectId
        ))
        && get(teacherAssignmentPath(
          schoolId,
          request.auth.uid,
          classId,
          subjectId
        )).data.status == "active"
        && get(teacherAssignmentPath(
          schoolId,
          request.auth.uid,
          classId,
          subjectId
        )).data.teacherId == request.auth.uid
        && get(teacherAssignmentPath(
          schoolId,
          request.auth.uid,
          classId,
          subjectId
        )).data.classId == classId
        && get(teacherAssignmentPath(
          schoolId,
          request.auth.uid,
          classId,
          subjectId
        )).data.subjectId == subjectId;
    }

    function isValidQuestionCreator(createdBy) {
      return createdBy is map
        && createdBy.keys().hasAll([
          "uid",
          "name",
          "email"
        ])
        && createdBy.keys().hasOnly([
          "uid",
          "name",
          "email"
        ])
        && createdBy.uid == request.auth.uid
        && (
          !currentUser().keys().hasAny(["uid"])
          || createdBy.uid == currentUser().uid
        )
        && createdBy.name is string
        && createdBy.name.size() > 0
        && createdBy.name == currentUser().name
        && createdBy.email is string
        && createdBy.email.size() > 0
        && createdBy.email == currentUser().email;
    }

    function isValidQuestionImage(schoolId, questionId, image) {
      return image is map
        && image.keys().hasAll([
          "storagePath",
          "downloadUrl"
        ])
        && image.keys().hasOnly([
          "storagePath",
          "downloadUrl"
        ])
        && (
          (
            image.storagePath == null
            && image.downloadUrl == null
          )
          || (
            image.storagePath is string
            && image.storagePath.size() > 0
            && image.storagePath.matches(
              "^schools/" + schoolId + "/questions/" + questionId + "/question-image/[^/]+$"
            )
            && image.downloadUrl is string
            && image.downloadUrl.size() > 0
          )
        );
    }

    function isValidQuestionTag(tag) {
      return tag is string
        && tag.size() > 0
        && tag.size() <= 50
        && tag.matches(".*\\S.*");
    }

    function isValidQuestionTags(tags) {
      return tags is list
        && tags.size() <= 10
        && (tags.size() < 1 || isValidQuestionTag(tags[0]))
        && (tags.size() < 2 || isValidQuestionTag(tags[1]))
        && (tags.size() < 3 || isValidQuestionTag(tags[2]))
        && (tags.size() < 4 || isValidQuestionTag(tags[3]))
        && (tags.size() < 5 || isValidQuestionTag(tags[4]))
        && (tags.size() < 6 || isValidQuestionTag(tags[5]))
        && (tags.size() < 7 || isValidQuestionTag(tags[6]))
        && (tags.size() < 8 || isValidQuestionTag(tags[7]))
        && (tags.size() < 9 || isValidQuestionTag(tags[8]))
        && (tags.size() < 10 || isValidQuestionTag(tags[9]));
    }

    function hasValidOptionalQuestionTags(data) {
      return !data.keys().hasAny(["tags"])
        || isValidQuestionTags(data.tags);
    }

    function isValidQuestionOption(option) {
      return option is map
        && option.keys().hasAll([
          "id",
          "text"
        ])
        && option.keys().hasOnly([
          "id",
          "text"
        ])
        && option.id is string
        && option.id.size() > 0
        && option.text is string
        && option.text.size() > 0;
    }

    function isValidQuestionOptions(options) {
      return options is list
        && options.size() >= 2
        && options.size() <= 8
        && isValidQuestionOption(options[0])
        && isValidQuestionOption(options[1])
        && (options.size() < 3 || isValidQuestionOption(options[2]))
        && (options.size() < 4 || isValidQuestionOption(options[3]))
        && (options.size() < 5 || isValidQuestionOption(options[4]))
        && (options.size() < 6 || isValidQuestionOption(options[5]))
        && (options.size() < 7 || isValidQuestionOption(options[6]))
        && (options.size() < 8 || isValidQuestionOption(options[7]));
    }

    function isQuestionCorrectOptionId(answerData) {
      return answerData.correctOptionId == answerData.options[0].id
        || answerData.correctOptionId == answerData.options[1].id
        || (
          answerData.options.size() > 2
          && answerData.correctOptionId == answerData.options[2].id
        )
        || (
          answerData.options.size() > 3
          && answerData.correctOptionId == answerData.options[3].id
        )
        || (
          answerData.options.size() > 4
          && answerData.correctOptionId == answerData.options[4].id
        )
        || (
          answerData.options.size() > 5
          && answerData.correctOptionId == answerData.options[5].id
        )
        || (
          answerData.options.size() > 6
          && answerData.correctOptionId == answerData.options[6].id
        )
        || (
          answerData.options.size() > 7
          && answerData.correctOptionId == answerData.options[7].id
        );
    }

    function isValidMultipleChoiceAnswerData(answerData) {
      return answerData is map
        && answerData.keys().hasAll([
          "options",
          "correctOptionId"
        ])
        && answerData.keys().hasOnly([
          "options",
          "correctOptionId"
        ])
        && answerData.correctOptionId is string
        && answerData.correctOptionId.size() > 0
        && isValidQuestionOptions(answerData.options)
        && isQuestionCorrectOptionId(answerData);
    }

    function isValidTrueFalseAnswerData(answerData) {
      return answerData is map
        && answerData.keys().hasAll([
          "correctAnswer"
        ])
        && answerData.keys().hasOnly([
          "correctAnswer"
        ])
        && answerData.correctAnswer is bool;
    }

    function isValidMatchFollowingPair(pair) {
      return pair is map
        && pair.keys().hasAll([
          "id",
          "left",
          "right"
        ])
        && pair.keys().hasOnly([
          "id",
          "left",
          "right"
        ])
        && pair.id is string
        && pair.id.size() > 0
        && pair.left is string
        && pair.left.size() > 0
        && pair.left.matches(".*\\S.*")
        && pair.right is string
        && pair.right.size() > 0
        && pair.right.matches(".*\\S.*");
    }

    function isValidMatchFollowingPairs(pairs) {
      return pairs is list
        && pairs.size() >= 2
        && pairs.size() <= 12
        && isValidMatchFollowingPair(pairs[0])
        && isValidMatchFollowingPair(pairs[1])
        && (pairs.size() < 3 || isValidMatchFollowingPair(pairs[2]))
        && (pairs.size() < 4 || isValidMatchFollowingPair(pairs[3]))
        && (pairs.size() < 5 || isValidMatchFollowingPair(pairs[4]))
        && (pairs.size() < 6 || isValidMatchFollowingPair(pairs[5]))
        && (pairs.size() < 7 || isValidMatchFollowingPair(pairs[6]))
        && (pairs.size() < 8 || isValidMatchFollowingPair(pairs[7]))
        && (pairs.size() < 9 || isValidMatchFollowingPair(pairs[8]))
        && (pairs.size() < 10 || isValidMatchFollowingPair(pairs[9]))
        && (pairs.size() < 11 || isValidMatchFollowingPair(pairs[10]))
        && (pairs.size() < 12 || isValidMatchFollowingPair(pairs[11]));
    }

    function isValidMatchFollowingAnswerData(answerData) {
      return answerData is map
        && answerData.keys().hasAll([
          "pairs"
        ])
        && answerData.keys().hasOnly([
          "pairs"
        ])
        && isValidMatchFollowingPairs(answerData.pairs);
    }

    function isMeaningfulRichTextNode(node) {
      return node is map
        && node.keys().hasAll([
          "type"
        ])
        && node.type is string
        && (
          (
            node.type == "text"
            && node.keys().hasAny([
              "text"
            ])
            && node.text is string
            && node.text.size() > 0
          )
          || (
            node.type == "image"
            && node.keys().hasAny([
              "attrs"
            ])
            && node.attrs is map
            && node.attrs.keys().hasAny([
              "src"
            ])
            && node.attrs.src is string
            && node.attrs.src.size() > 0
          )
          || (
            node.type == "table"
            && node.keys().hasAny([
              "content"
            ])
            && node.content is list
            && node.content.size() > 0
          )
          || (
            node.keys().hasAny([
              "content"
            ])
            && node.content is list
            && node.content.size() > 0
          )
        );
    }

    function hasMeaningfulRichTextTopLevelContent(content) {
      return content is list
        && content.size() > 0
        && (
          isMeaningfulRichTextNode(content[0])
          || (
            content.size() > 1
            && isMeaningfulRichTextNode(content[1])
          )
          || (
            content.size() > 2
            && isMeaningfulRichTextNode(content[2])
          )
          || (
            content.size() > 3
            && isMeaningfulRichTextNode(content[3])
          )
          || (
            content.size() > 4
            && isMeaningfulRichTextNode(content[4])
          )
          || (
            content.size() > 5
            && isMeaningfulRichTextNode(content[5])
          )
          || (
            content.size() > 6
            && isMeaningfulRichTextNode(content[6])
          )
          || (
            content.size() > 7
            && isMeaningfulRichTextNode(content[7])
          )
          || (
            content.size() > 8
            && isMeaningfulRichTextNode(content[8])
          )
          || (
            content.size() > 9
            && isMeaningfulRichTextNode(content[9])
          )
        );
    }

    function isValidRichTextDocument(contentDoc) {
      return contentDoc is map
        && contentDoc.keys().hasAll([
          "type",
          "content"
        ])
        && contentDoc.keys().hasOnly([
          "type",
          "content"
        ])
        && contentDoc.type == "doc"
        && contentDoc.content is list
        && contentDoc.content.size() <= 100
        && hasMeaningfulRichTextTopLevelContent(contentDoc.content);
    }

    function isValidShortAnswerAnswerData(answerData) {
      return answerData is map
        && answerData.keys().hasAll([
          "questionContent",
          "modelAnswer"
        ])
        && answerData.keys().hasOnly([
          "questionContent",
          "modelAnswer"
        ])
        && isValidRichTextDocument(answerData.questionContent)
        && isValidRichTextDocument(answerData.modelAnswer);
    }

    function isValidLongAnswerAnswerData(answerData) {
      return answerData is map
        && answerData.keys().hasAll([
          "questionContent",
          "modelAnswer",
          "suggestedWordCount"
        ])
        && answerData.keys().hasOnly([
          "questionContent",
          "modelAnswer",
          "suggestedWordCount"
        ])
        && isValidRichTextDocument(answerData.questionContent)
        && isValidRichTextDocument(answerData.modelAnswer)
        && (
          answerData.suggestedWordCount == null
          || (
            answerData.suggestedWordCount is int
            && answerData.suggestedWordCount > 0
          )
        );
    }

    function isValidFillBlankAcceptedAnswers(acceptedAnswers) {
      return acceptedAnswers is list
        && acceptedAnswers.size() >= 1
        && acceptedAnswers.size() <= 10
        && acceptedAnswers[0] is string
        && acceptedAnswers[0].size() > 0
        && (acceptedAnswers.size() < 2 || (
          acceptedAnswers[1] is string
          && acceptedAnswers[1].size() > 0
        ))
        && (acceptedAnswers.size() < 3 || (
          acceptedAnswers[2] is string
          && acceptedAnswers[2].size() > 0
        ))
        && (acceptedAnswers.size() < 4 || (
          acceptedAnswers[3] is string
          && acceptedAnswers[3].size() > 0
        ))
        && (acceptedAnswers.size() < 5 || (
          acceptedAnswers[4] is string
          && acceptedAnswers[4].size() > 0
        ))
        && (acceptedAnswers.size() < 6 || (
          acceptedAnswers[5] is string
          && acceptedAnswers[5].size() > 0
        ))
        && (acceptedAnswers.size() < 7 || (
          acceptedAnswers[6] is string
          && acceptedAnswers[6].size() > 0
        ))
        && (acceptedAnswers.size() < 8 || (
          acceptedAnswers[7] is string
          && acceptedAnswers[7].size() > 0
        ))
        && (acceptedAnswers.size() < 9 || (
          acceptedAnswers[8] is string
          && acceptedAnswers[8].size() > 0
        ))
        && (acceptedAnswers.size() < 10 || (
          acceptedAnswers[9] is string
          && acceptedAnswers[9].size() > 0
        ));
    }

    function isValidFillBlankAnswer(blank) {
      return blank is map
        && blank.keys().hasAll([
          "id",
          "acceptedAnswers"
        ])
        && blank.keys().hasOnly([
          "id",
          "acceptedAnswers"
        ])
        && blank.id is string
        && blank.id.size() > 0
        && isValidFillBlankAcceptedAnswers(blank.acceptedAnswers);
    }

    function isValidFillBlankAnswers(blanks) {
      return blanks is list
        && blanks.size() >= 1
        && blanks.size() <= 10
        && isValidFillBlankAnswer(blanks[0])
        && (blanks.size() < 2 || isValidFillBlankAnswer(blanks[1]))
        && (blanks.size() < 3 || isValidFillBlankAnswer(blanks[2]))
        && (blanks.size() < 4 || isValidFillBlankAnswer(blanks[3]))
        && (blanks.size() < 5 || isValidFillBlankAnswer(blanks[4]))
        && (blanks.size() < 6 || isValidFillBlankAnswer(blanks[5]))
        && (blanks.size() < 7 || isValidFillBlankAnswer(blanks[6]))
        && (blanks.size() < 8 || isValidFillBlankAnswer(blanks[7]))
        && (blanks.size() < 9 || isValidFillBlankAnswer(blanks[8]))
        && (blanks.size() < 10 || isValidFillBlankAnswer(blanks[9]));
    }

    function isValidFillBlanksAnswerData(answerData) {
      return answerData is map
        && answerData.keys().hasAll([
          "blanks"
        ])
        && answerData.keys().hasOnly([
          "blanks"
        ])
        && isValidFillBlankAnswers(answerData.blanks);
    }

    function isValidQuestionType(questionType) {
      return questionType in [
        "fill_blanks",
        "long_answer",
        "match_following",
        "multiple_choice",
        "short_answer",
        "true_false"
      ];
    }

    function isValidQuestionAnswerData(questionType, answerData) {
      return (
          questionType == "fill_blanks"
          && isValidFillBlanksAnswerData(answerData)
        )
        || (
          questionType == "match_following"
          && isValidMatchFollowingAnswerData(answerData)
        )
        || (
          questionType == "multiple_choice"
          && isValidMultipleChoiceAnswerData(answerData)
        )
        || (
          questionType == "long_answer"
          && isValidLongAnswerAnswerData(answerData)
        )
        || (
          questionType == "short_answer"
          && isValidShortAnswerAnswerData(answerData)
        )
        || (
          questionType == "true_false"
          && isValidTrueFalseAnswerData(answerData)
        );
    }

    function isValidQuestionCreate(schoolId, questionId) {
      return isActiveTeacher()
        && currentUser().schoolId == schoolId
        && request.resource.data.keys().hasAll([
          "questionType",
          "classId",
          "subjectId",
          "topicName",
          "prompt",
          "marks",
          "difficulty",
          "instructions",
          "image",
          "answerData",
          "createdBy",
          "createdAt",
          "updatedAt",
          "status"
        ])
        && request.resource.data.keys().hasOnly([
          "questionType",
          "classId",
          "subjectId",
          "topicName",
          "prompt",
          "marks",
          "difficulty",
          "instructions",
          "image",
          "answerData",
          "tags",
          "createdBy",
          "createdAt",
          "updatedAt",
          "status"
        ])
        && isValidQuestionType(request.resource.data.questionType)
        && request.resource.data.classId is string
        && request.resource.data.classId.size() > 0
        && request.resource.data.subjectId is string
        && request.resource.data.subjectId.size() > 0
        && request.resource.data.topicName is string
        && request.resource.data.topicName.size() > 0
        && request.resource.data.topicName.size() <= 100
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() > 0
        && request.resource.data.marks is int
        && request.resource.data.marks > 0
        && validQuestionDifficulty(request.resource.data.difficulty)
        && request.resource.data.instructions is string
        && isValidQuestionImage(
          schoolId,
          questionId,
          request.resource.data.image
        )
        && hasValidOptionalQuestionTags(request.resource.data)
        && isValidQuestionAnswerData(
          request.resource.data.questionType,
          request.resource.data.answerData
        )
        && isValidQuestionCreator(request.resource.data.createdBy)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status == "active"
        && isTeacherAssignedToQuestionSubject(
          schoolId,
          request.resource.data.classId,
          request.resource.data.subjectId
        );
    }

    function isValidQuestionUpdate(schoolId, questionId) {
      return isActiveTeacher()
        && currentUser().schoolId == schoolId
        && resource.data.status == "active"
        && resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          "questionType",
          "classId",
          "subjectId",
          "topicName",
          "prompt",
          "marks",
          "difficulty",
          "instructions",
          "image",
          "answerData",
          "createdBy",
          "createdAt",
          "updatedAt",
          "status"
        ])
        && request.resource.data.keys().hasOnly([
          "questionType",
          "classId",
          "subjectId",
          "topicName",
          "prompt",
          "marks",
          "difficulty",
          "instructions",
          "image",
          "answerData",
          "tags",
          "createdBy",
          "createdAt",
          "updatedAt",
          "status"
        ])
        && isValidQuestionType(request.resource.data.questionType)
        && request.resource.data.classId is string
        && request.resource.data.classId.size() > 0
        && request.resource.data.subjectId is string
        && request.resource.data.subjectId.size() > 0
        && request.resource.data.topicName is string
        && request.resource.data.topicName.size() > 0
        && request.resource.data.topicName.size() <= 100
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() > 0
        && request.resource.data.marks is int
        && request.resource.data.marks > 0
        && validQuestionDifficulty(request.resource.data.difficulty)
        && request.resource.data.instructions is string
        && isValidQuestionImage(
          schoolId,
          questionId,
          request.resource.data.image
        )
        && hasValidOptionalQuestionTags(request.resource.data)
        && isValidQuestionAnswerData(
          request.resource.data.questionType,
          request.resource.data.answerData
        )
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ["active", "deleted"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "questionType",
          "classId",
          "subjectId",
          "topicName",
          "prompt",
          "marks",
          "difficulty",
          "instructions",
          "image",
          "answerData",
          "tags",
          "updatedAt",
          "status"
        ])
        && isTeacherAssignedToQuestionSubject(
          schoolId,
          request.resource.data.classId,
          request.resource.data.subjectId
        );
    }

    function questionShareId(questionId, teacherId) {
      return questionId + "__" + teacherId;
    }

    function isOwnedActiveQuestion(schoolId, questionId, ownerId) {
      return exists(questionPath(schoolId, questionId))
        && get(questionPath(schoolId, questionId)).data.status == "active"
        && get(questionPath(schoolId, questionId)).data.createdBy.uid == ownerId;
    }

    function hasActiveQuestionShare(schoolId, questionId) {
      return exists(questionSharePath(
          schoolId,
          questionShareId(questionId, request.auth.uid)
        ))
        && get(questionSharePath(
          schoolId,
          questionShareId(questionId, request.auth.uid)
        )).data.questionId == questionId
        && get(questionSharePath(
          schoolId,
          questionShareId(questionId, request.auth.uid)
        )).data.sharedWithTeacherId == request.auth.uid
        && get(questionSharePath(
          schoolId,
          questionShareId(questionId, request.auth.uid)
        )).data.status == "active";
    }

    function canReadQuestion(schoolId, questionId) {
      return isActivePlatformAdmin()
        || isOwnSchool(schoolId)
        || (
          isActiveTeacher()
          && currentUser().schoolId == schoolId
          && resource.data.createdBy.uid == request.auth.uid
        )
        || (
          isActiveTeacher()
          && currentUser().schoolId == schoolId
          && resource.data.status == "active"
          && hasActiveQuestionShare(schoolId, questionId)
        );
    }

    function isValidQuestionSharePayload(data, shareId) {
      return data.keys().hasAll([
          "questionId",
          "ownerId",
          "sharedWithTeacherId",
          "sharedByTeacherId",
          "status",
          "createdAt",
          "updatedAt",
          "revokedAt"
        ])
        && data.keys().hasOnly([
          "questionId",
          "ownerId",
          "sharedWithTeacherId",
          "sharedByTeacherId",
          "status",
          "createdAt",
          "updatedAt",
          "revokedAt"
        ])
        && data.questionId is string
        && data.questionId.size() > 0
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.sharedWithTeacherId is string
        && data.sharedWithTeacherId.size() > 0
        && data.sharedByTeacherId is string
        && data.sharedByTeacherId.size() > 0
        && data.ownerId != data.sharedWithTeacherId
        && data.status in ["active", "revoked"]
        && shareId == questionShareId(data.questionId, data.sharedWithTeacherId);
    }

    function isValidQuestionShareCreate(schoolId, shareId) {
      return isActiveTeacher()
        && currentUser().schoolId == schoolId
        && isValidQuestionSharePayload(request.resource.data, shareId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sharedByTeacherId == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revokedAt == null
        && isTeacherProfileInSchool(
          schoolId,
          request.resource.data.sharedWithTeacherId
        )
        && isOwnedActiveQuestion(
          schoolId,
          request.resource.data.questionId,
          request.auth.uid
        );
    }

    function hasStableQuestionShareIdentity(shareId) {
      return isValidQuestionSharePayload(request.resource.data, shareId)
        && request.resource.data.questionId == resource.data.questionId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.sharedWithTeacherId
          == resource.data.sharedWithTeacherId
        && request.resource.data.sharedByTeacherId
          == resource.data.sharedByTeacherId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt",
          "revokedAt"
        ]);
    }

    function isQuestionShareActor(schoolId) {
      return isActiveTeacher()
        && currentUser().schoolId == schoolId
        && (
          resource.data.ownerId == request.auth.uid
          || resource.data.sharedWithTeacherId == request.auth.uid
        );
    }

    function isValidQuestionShareRevoke(schoolId, shareId) {
      return hasStableQuestionShareIdentity(shareId)
        && isQuestionShareActor(schoolId)
        && resource.data.status == "active"
        && request.resource.data.status == "revoked"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revokedAt == request.time;
    }

    function isValidQuestionShareReactivate(schoolId, shareId) {
      return hasStableQuestionShareIdentity(shareId)
        && isActiveTeacher()
        && currentUser().schoolId == schoolId
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == "revoked"
        && request.resource.data.status == "active"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revokedAt == null
        && isTeacherProfileInSchool(
          schoolId,
          resource.data.sharedWithTeacherId
        )
        && isOwnedActiveQuestion(
          schoolId,
          resource.data.questionId,
          request.auth.uid
        );
    }

    function isValidQuestionShareUpdate(schoolId, shareId) {
      return isValidQuestionShareRevoke(schoolId, shareId)
        || isValidQuestionShareReactivate(schoolId, shareId);
    }

    function canReadQuestionShare(schoolId) {
      return isActivePlatformAdmin()
        || isOwnSchool(schoolId)
        || (
          isActiveTeacher()
          && currentUser().schoolId == schoolId
          && (
            resource.data.ownerId == request.auth.uid
            || resource.data.sharedWithTeacherId == request.auth.uid
          )
        );
    }

    function isOptionalPositiveInt(value) {
      return value == null || (value is int && value > 0);
    }

    function isValidQuestionPaperSetupPayload(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.classId is string
        && data.classId.size() > 0
        && data.subjectId is string
        && data.subjectId.size() > 0
        && data.examName is string
        && data.examName.size() <= 120
        && data.term is string
        && data.term.size() <= 80
        && data.academicYear is string
        && data.academicYear.size() <= 40
        && isOptionalPositiveInt(data.durationMinutes)
        && isOptionalPositiveInt(data.maximumMarks);
    }

    function isValidQuestionPaperQuestion(question) {
      return question is map
        && question.keys().hasAll([
          "blockId",
          "questionId",
          "questionNumber",
          "marks",
          "difficulty",
          "questionType",
          "snapshot"
        ])
        && question.keys().hasOnly([
          "blockId",
          "questionId",
          "questionNumber",
          "marks",
          "difficulty",
          "questionType",
          "snapshot"
        ])
        && question.blockId is string
        && question.blockId.size() > 0
        && question.questionId is string
        && question.questionId.size() > 0
        && question.questionNumber is string
        && question.questionNumber.size() > 0
        && question.marks is int
        && question.marks > 0
        && validQuestionDifficulty(question.difficulty)
        && isValidQuestionType(question.questionType)
        && question.snapshot is map;
    }

    function isValidQuestionPaperQuestions(questions) {
      return questions is list
        && questions.size() <= 100
        && (questions.size() < 1 || isValidQuestionPaperQuestion(questions[0]))
        && (questions.size() < 2 || isValidQuestionPaperQuestion(questions[1]))
        && (questions.size() < 3 || isValidQuestionPaperQuestion(questions[2]))
        && (questions.size() < 4 || isValidQuestionPaperQuestion(questions[3]))
        && (questions.size() < 5 || isValidQuestionPaperQuestion(questions[4]))
        && (questions.size() < 6 || isValidQuestionPaperQuestion(questions[5]))
        && (questions.size() < 7 || isValidQuestionPaperQuestion(questions[6]))
        && (questions.size() < 8 || isValidQuestionPaperQuestion(questions[7]))
        && (questions.size() < 9 || isValidQuestionPaperQuestion(questions[8]))
        && (questions.size() < 10 || isValidQuestionPaperQuestion(questions[9]))
        && (questions.size() < 11 || isValidQuestionPaperQuestion(questions[10]))
        && (questions.size() < 12 || isValidQuestionPaperQuestion(questions[11]))
        && (questions.size() < 13 || isValidQuestionPaperQuestion(questions[12]))
        && (questions.size() < 14 || isValidQuestionPaperQuestion(questions[13]))
        && (questions.size() < 15 || isValidQuestionPaperQuestion(questions[14]))
        && (questions.size() < 16 || isValidQuestionPaperQuestion(questions[15]))
        && (questions.size() < 17 || isValidQuestionPaperQuestion(questions[16]))
        && (questions.size() < 18 || isValidQuestionPaperQuestion(questions[17]))
        && (questions.size() < 19 || isValidQuestionPaperQuestion(questions[18]))
        && (questions.size() < 20 || isValidQuestionPaperQuestion(questions[19]));
    }

    function isValidQuestionPaperDifficultySummaryItem(item) {
      return item is map
        && item.keys().hasAll([
          "difficulty",
          "label",
          "marks"
        ])
        && item.keys().hasOnly([
          "difficulty",
          "label",
          "marks"
        ])
        && validQuestionDifficulty(item.difficulty)
        && item.label is string
        && item.label.size() > 0
        && item.marks is int
        && item.marks >= 0;
    }

    function isValidQuestionPaperDifficultySummary(summary) {
      return summary is map
        && summary.keys().hasAll([
          "averageWeight",
          "distribution",
          "overallDifficulty"
        ])
        && summary.keys().hasOnly([
          "averageWeight",
          "distribution",
          "overallDifficulty"
        ])
        && (
          summary.averageWeight is int
          || summary.averageWeight is float
        )
        && summary.averageWeight >= 0
        && summary.distribution is list
        && summary.distribution.size() == 3
        && isValidQuestionPaperDifficultySummaryItem(summary.distribution[0])
        && isValidQuestionPaperDifficultySummaryItem(summary.distribution[1])
        && isValidQuestionPaperDifficultySummaryItem(summary.distribution[2])
        && summary.overallDifficulty in [
          "Not set",
          "Easy",
          "Medium",
          "Hard"
        ];
    }

    function isValidQuestionPaperStatusPayload(data) {
      return (
          data.status == "draft"
          && !data.keys().hasAny(["finalizedAt"])
        )
        || (
          data.status == "final"
          && data.keys().hasAll(["finalizedAt"])
          && data.finalizedAt is timestamp
        );
    }

    function isValidQuestionPaperPayload(data) {
      return data.keys().hasAll([
          "title",
          "classId",
          "subjectId",
          "examName",
          "term",
          "academicYear",
          "durationMinutes",
          "maximumMarks",
          "documentContent",
          "questions",
          "totalQuestions",
          "totalMarks",
          "difficultySummary",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "title",
          "classId",
          "subjectId",
          "examName",
          "term",
          "academicYear",
          "durationMinutes",
          "maximumMarks",
          "documentContent",
          "questions",
          "totalQuestions",
          "totalMarks",
          "difficultySummary",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt",
          "finalizedAt"
        ])
        && isValidQuestionPaperSetupPayload(data)
        && isValidRichTextDocument(data.documentContent)
        && isValidQuestionPaperQuestions(data.questions)
        && data.totalQuestions is int
        && data.totalQuestions == data.questions.size()
        && data.totalMarks is int
        && data.totalMarks >= 0
        && isValidQuestionPaperDifficultySummary(data.difficultySummary)
        && isValidQuestionPaperStatusPayload(data);
    }

    function isValidQuestionPaperDraftPayload(data) {
      return isValidQuestionPaperPayload(data)
        && data.status == "draft"
        && !data.keys().hasAny(["finalizedAt"]);
    }

    function isValidQuestionPaperFinalPayload(data) {
      return isValidQuestionPaperPayload(data)
        && data.status == "final"
        && data.finalizedAt is timestamp
        && data.totalQuestions > 0
        && data.totalMarks > 0;
    }

    function isValidQuestionPaperCreate(schoolId) {
      return isActiveTeacher()
        && currentUser().schoolId == schoolId
        && isValidQuestionPaperDraftPayload(request.resource.data)
        && isValidQuestionCreator(request.resource.data.createdBy)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidQuestionPaperDraftUpdate(schoolId) {
      return isActiveTeacher()
        && currentUser().schoolId == schoolId
        && resource.data.status == "draft"
        && resource.data.createdBy.uid == request.auth.uid
        && isValidQuestionPaperDraftPayload(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status == "draft"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title",
          "classId",
          "subjectId",
          "examName",
          "term",
          "academicYear",
          "durationMinutes",
          "maximumMarks",
          "documentContent",
          "questions",
          "totalQuestions",
          "totalMarks",
          "difficultySummary",
          "status",
          "updatedAt"
        ]);
    }

    function isValidQuestionPaperFinalization(schoolId) {
      return isActiveTeacher()
        && currentUser().schoolId == schoolId
        && resource.data.status == "draft"
        && resource.data.createdBy.uid == request.auth.uid
        && isValidQuestionPaperFinalPayload(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.finalizedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "finalizedAt",
          "updatedAt"
        ]);
    }

    function isValidQuestionPaperUpdate(schoolId) {
      return isValidQuestionPaperDraftUpdate(schoolId)
        || isValidQuestionPaperFinalization(schoolId);
    }

    function canReadQuestionPaper(schoolId) {
      return isActiveTeacher()
        && currentUser().schoolId == schoolId
        && resource.data.createdBy.uid == request.auth.uid;
    }

    function isValidSchoolPayload(data) {
      return data.name is string
        && data.name.size() > 0
        && data.code is string
        && data.code.size() > 0
        && data.email is string
        && data.phone is string
        && data.address is string
        && data.city is string
        && data.country is string
        && validSchoolStatus(data.status)
        && (
          !data.keys().hasAny(["adminIds"])
          || data.adminIds is list
        )
        && (
          !data.keys().hasAny(["allowJoinRequests"])
          || data.allowJoinRequests is bool
        );
    }

    function isValidSchoolCreate() {
      return request.resource.data.keys().hasAll([
          "name",
          "code",
          "email",
          "phone",
          "address",
          "city",
          "country",
          "status",
          "adminIds",
          "allowJoinRequests",
          "primaryAdminId",
          "createdAt",
          "updatedAt",
          "createdBy"
        ])
        && request.resource.data.keys().hasOnly([
          "name",
          "code",
          "email",
          "phone",
          "address",
          "city",
          "country",
          "status",
          "adminIds",
          "allowJoinRequests",
          "primaryAdminId",
          "createdAt",
          "updatedAt",
          "createdBy"
        ])
        && isValidSchoolPayload(request.resource.data)
        && request.resource.data.adminIds.size() == 0
        && request.resource.data.allowJoinRequests == true
        && request.resource.data.primaryAdminId == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidSchoolUpdate() {
      return isValidSchoolPayload(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "adminIds",
          "primaryAdminId",
          "createdAt",
          "createdBy"
        ])
        && request.resource.data.updatedAt == request.time;
    }

    function isSelfServiceSchoolAdminProfileAfter(userId, schoolId) {
      return existsAfter(userPath(userId))
        && getAfter(userPath(userId)).data.uid == userId
        && getAfter(userPath(userId)).data.email == authEmail()
        && getAfter(userPath(userId)).data.role == "school_admin"
        && getAfter(userPath(userId)).data.status == "active"
        && getAfter(userPath(userId)).data.schoolId == schoolId
        && getAfter(userPath(userId)).data.createdAt == request.time
        && getAfter(userPath(userId)).data.updatedAt == request.time
        && getAfter(schoolPath(schoolId)).data.adminIds is list
        && getAfter(schoolPath(schoolId)).data.adminIds.size() == 1
        && getAfter(schoolPath(schoolId)).data.adminIds[0] == userId;
    }

    function isValidSelfServiceSchoolCreate(schoolId) {
      return signedIn()
        && hasVerifiedAuthEmail()
        && !exists(userPath(request.auth.uid))
        && request.resource.data.keys().hasAll([
          "name",
          "code",
          "email",
          "phone",
          "address",
          "city",
          "country",
          "status",
          "adminIds",
          "allowJoinRequests",
          "primaryAdminId",
          "createdAt",
          "updatedAt",
          "createdBy"
        ])
        && request.resource.data.keys().hasOnly([
          "name",
          "code",
          "email",
          "phone",
          "address",
          "city",
          "country",
          "status",
          "adminIds",
          "allowJoinRequests",
          "primaryAdminId",
          "createdAt",
          "updatedAt",
          "createdBy"
        ])
        && isValidSchoolPayload(request.resource.data)
        && request.resource.data.status == "active"
        && request.resource.data.adminIds is list
        && request.resource.data.adminIds.size() == 1
        && request.resource.data.adminIds[0] == request.auth.uid
        && request.resource.data.allowJoinRequests == true
        && request.resource.data.primaryAdminId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isSelfServiceSchoolAdminProfileAfter(request.auth.uid, schoolId);
    }

    function isAcceptingJoinRequestsSchool(schoolId) {
      return exists(schoolPath(schoolId))
        && get(schoolPath(schoolId)).data.status == "active"
        && (
          !get(schoolPath(schoolId)).data.keys().hasAny(["allowJoinRequests"])
          || get(schoolPath(schoolId)).data.allowJoinRequests == true
        );
    }

    function isValidPendingTeacherProfileAfter(userId, schoolId) {
      return existsAfter(userPath(userId))
        && getAfter(userPath(userId)).data.uid == userId
        && getAfter(userPath(userId)).data.name is string
        && getAfter(userPath(userId)).data.name.size() > 0
        && getAfter(userPath(userId)).data.email == authEmail()
        && getAfter(userPath(userId)).data.role == "teacher"
        && getAfter(userPath(userId)).data.status == "pending_approval"
        && getAfter(userPath(userId)).data.schoolId == schoolId
        && (
          getAfter(userPath(userId)).data.photoURL == null
          || getAfter(userPath(userId)).data.photoURL is string
        )
        && getAfter(userPath(userId)).data.createdAt == request.time
        && getAfter(userPath(userId)).data.updatedAt == request.time;
    }

    function isValidJoinRequestCreate(schoolId, userId) {
      return signedIn()
        && hasVerifiedOrGoogleAuthEmail()
        && request.auth.uid == userId
        && !exists(userPath(request.auth.uid))
        && request.resource.data.keys().hasAll([
          "userId",
          "name",
          "email",
          "requestedRole",
          "status",
          "createdAt",
          "updatedAt",
          "reviewedAt",
          "reviewedBy"
        ])
        && request.resource.data.keys().hasOnly([
          "userId",
          "name",
          "email",
          "requestedRole",
          "status",
          "createdAt",
          "updatedAt",
          "reviewedAt",
          "reviewedBy"
        ])
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email == authEmail()
        && request.resource.data.requestedRole == "teacher"
        && request.resource.data.status == "pending"
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isAcceptingJoinRequestsSchool(schoolId)
        && isValidPendingTeacherProfileAfter(userId, schoolId);
    }

    function isPendingTeacherInOwnSchool(schoolId) {
      return currentUserExists()
        && currentUser().role == "teacher"
        && currentUser().status == "pending_approval"
        && currentUser().schoolId == schoolId;
    }

    function isOwnJoinRequest(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isReviewedTeacherProfileAfter(userId, schoolId, reviewStatus) {
      return existsAfter(userPath(userId))
        && getAfter(userPath(userId)).data.uid == userId
        && getAfter(userPath(userId)).data.role == "teacher"
        && getAfter(userPath(userId)).data.schoolId == schoolId
        && getAfter(userPath(userId)).data.updatedAt == request.time
        && (
          (
            reviewStatus == "approved"
            && getAfter(userPath(userId)).data.status == "active"
          )
          || (
            reviewStatus == "rejected"
            && getAfter(userPath(userId)).data.status == "disabled"
          )
        );
    }

    function isValidJoinRequestReview(schoolId, userId) {
      return isOwnSchool(schoolId)
        && request.auth.uid != userId
        && resource.data.userId == userId
        && resource.data.requestedRole == "teacher"
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt",
          "reviewedAt",
          "reviewedBy"
        ])
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && isReviewedTeacherProfileAfter(
          userId,
          schoolId,
          request.resource.data.status
        );
    }

    function isValidSchoolJoinRequestSettingUpdate(schoolId) {
      return isOwnSchool(schoolId)
        && isValidSchoolPayload(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "allowJoinRequests",
          "updatedAt"
        ])
        && request.resource.data.allowJoinRequests is bool
        && request.resource.data.updatedAt == request.time;
    }

    function isActiveSchoolAdminProfileAfter(userId, schoolId) {
      return existsAfter(userPath(userId))
        && getAfter(userPath(userId)).data.uid == userId
        && getAfter(userPath(userId)).data.schoolId == schoolId
        && getAfter(userPath(userId)).data.role == "school_admin"
        && getAfter(userPath(userId)).data.status == "active";
    }

    function isValidSchoolRoleRosterUpdate(schoolId) {
      return isOwnSchool(schoolId)
        && isValidSchoolPayload(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "adminIds",
          "primaryAdminId",
          "updatedAt"
        ])
        && request.resource.data.adminIds is list
        && request.resource.data.adminIds.size() > 0
        && request.resource.data.primaryAdminId is string
        && request.resource.data.primaryAdminId.size() > 0
        && request.resource.data.adminIds.hasAny([
          request.resource.data.primaryAdminId
        ])
        && isActiveSchoolAdminProfileAfter(
          request.resource.data.primaryAdminId,
          schoolId
        )
        && request.resource.data.updatedAt == request.time;
    }

    function isOwnSchool(schoolId) {
      return isActiveSchoolAdmin() && currentUser().schoolId == schoolId;
    }

    function isSchoolUserInOwnSchool() {
      return isActiveSchoolAdmin()
        && resource.data.schoolId == currentUser().schoolId
        && resource.data.status == "active"
        && resource.data.role in ["teacher", "school_admin"];
    }

    function isPendingTeacherProfileInOwnSchool() {
      return isActiveSchoolAdmin()
        && resource.data.schoolId == currentUser().schoolId
        && resource.data.role == "teacher"
        && resource.data.status == "pending_approval";
    }

    function canListSchoolUsersInOwnSchool() {
      return isActiveSchoolAdmin()
        && resource.data.schoolId == currentUser().schoolId
        && resource.data.role in ["teacher", "school_admin"];
    }

    function isTeacherPeerInOwnSchool() {
      return isActiveTeacher()
        && resource.data.role == "teacher"
        && resource.data.status == "active"
        && resource.data.schoolId == currentUser().schoolId;
    }

    function isValidOwnProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "photoURL",
          "updatedAt"
        ]);
    }

    function validInvitationRole(role) {
      return role == "school_admin";
    }

    function isValidInvitationBaseCreate(invitationId) {
      return request.resource.data.keys().hasAll([
          "token",
          "email",
          "name",
          "role",
          "schoolId",
          "status",
          "invitedBy",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "acceptedAt",
          "acceptedBy"
        ])
        && request.resource.data.keys().hasOnly([
          "token",
          "email",
          "name",
          "role",
          "schoolId",
          "schoolName",
          "status",
          "invitedBy",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "acceptedAt",
          "acceptedBy"
        ])
        && request.resource.data.token == invitationId
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && validInvitationRole(request.resource.data.role)
        && request.resource.data.schoolId is string
        && request.resource.data.status == "pending"
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.acceptedAt == null
        && request.resource.data.acceptedBy == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt > request.time
        && exists(schoolPath(request.resource.data.schoolId))
        && get(schoolPath(request.resource.data.schoolId)).data.status == "active";
    }

    function isValidSchoolAdminInvitationCreate(invitationId) {
      return isActivePlatformAdmin()
        && isValidInvitationBaseCreate(invitationId)
        && request.resource.data.role == "school_admin"
        && request.resource.data.schoolName is string
        && get(schoolPath(request.resource.data.schoolId)).data.primaryAdminId == null
        && get(schoolPath(request.resource.data.schoolId)).data.name
          == request.resource.data.schoolName;
    }

    function isValidInvitationCreate(invitationId) {
      return isValidSchoolAdminInvitationCreate(invitationId);
    }

    function canCancelInvitation() {
      return isActivePlatformAdmin();
    }

    function isValidInvitationCancel() {
      return canCancelInvitation()
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt"
        ])
        && request.resource.data.status == "cancelled"
        && request.resource.data.updatedAt == request.time;
    }

    function isPendingInvitation(invitationId) {
      return exists(invitationPath(invitationId))
        && get(invitationPath(invitationId)).data.token == invitationId
        && validInvitationRole(get(invitationPath(invitationId)).data.role)
        && get(invitationPath(invitationId)).data.status == "pending"
        && get(invitationPath(invitationId)).data.expiresAt > request.time;
    }

    function authMatchesInvitation(invitationId) {
      return hasVerifiedAuthEmail()
        && authEmail() == get(invitationPath(invitationId)).data.email;
    }

    function isPendingInvitationForAuth(invitationId) {
      return isPendingInvitation(invitationId)
        && authMatchesInvitation(invitationId);
    }

    function isActiveInvitationSchool(schoolId, invitationId) {
      return exists(schoolPath(schoolId))
        && get(invitationPath(invitationId)).data.schoolId == schoolId
        && get(schoolPath(schoolId)).data.status == "active";
    }

    function isRedeemableSchoolAdminSchool(schoolId, invitationId) {
      return isActiveInvitationSchool(schoolId, invitationId)
        && get(schoolPath(schoolId)).data.primaryAdminId == null;
    }

    function isAcceptedInvitationAfter(invitationId, userId) {
      return existsAfter(invitationPath(invitationId))
        && getAfter(invitationPath(invitationId)).data.status == "accepted"
        && getAfter(invitationPath(invitationId)).data.acceptedBy == userId
        && getAfter(invitationPath(invitationId)).data.acceptedAt == request.time
        && getAfter(invitationPath(invitationId)).data.updatedAt == request.time;
    }

    function isPrimaryAdminAfter(schoolId, userId) {
      return existsAfter(schoolPath(schoolId))
        && getAfter(schoolPath(schoolId)).data.primaryAdminId == userId
        && getAfter(schoolPath(schoolId)).data.updatedAt == request.time;
    }

    function isInviteeProfileAfter(userId, schoolId, invitationId, role) {
      return existsAfter(userPath(userId))
        && getAfter(userPath(userId)).data.uid == userId
        && getAfter(userPath(userId)).data.email == authEmail()
        && getAfter(userPath(userId)).data.email
          == get(invitationPath(invitationId)).data.email
        && getAfter(userPath(userId)).data.role == role
        && getAfter(userPath(userId)).data.status == "active"
        && getAfter(userPath(userId)).data.schoolId == schoolId
        && getAfter(userPath(userId)).data.invitationId == invitationId;
    }

    function isValidInviteeProfileBaseCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          "uid",
          "name",
          "email",
          "role",
          "status",
          "schoolId",
          "photoURL",
          "createdAt",
          "updatedAt",
          "invitationId"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "role",
          "status",
          "schoolId",
          "photoURL",
          "createdAt",
          "updatedAt",
          "invitationId"
        ])
        && request.resource.data.invitationId is string
        && isPendingInvitationForAuth(request.resource.data.invitationId)
        && request.resource.data.uid == userId
        && request.resource.data.name
          == get(invitationPath(request.resource.data.invitationId)).data.name
        && request.resource.data.email == authEmail()
        && request.resource.data.email
          == get(invitationPath(request.resource.data.invitationId)).data.email
        && request.resource.data.role
          == get(invitationPath(request.resource.data.invitationId)).data.role
        && request.resource.data.status == "active"
        && request.resource.data.schoolId
          == get(invitationPath(request.resource.data.invitationId)).data.schoolId
        && (
          request.resource.data.photoURL == null
          || request.resource.data.photoURL is string
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isActiveInvitationSchool(
          request.resource.data.schoolId,
          request.resource.data.invitationId
        )
        && isAcceptedInvitationAfter(request.resource.data.invitationId, userId);
    }

    function isValidSchoolAdminProfileCreate(userId) {
      return isValidInviteeProfileBaseCreate(userId)
        && request.resource.data.role == "school_admin"
        && isRedeemableSchoolAdminSchool(
          request.resource.data.schoolId,
          request.resource.data.invitationId
        )
        && isPrimaryAdminAfter(request.resource.data.schoolId, userId);
    }

    function isValidInviteeProfileCreate(userId) {
      return isValidSchoolAdminProfileCreate(userId);
    }

    function isValidSelfServiceSchoolAdminProfileCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && hasVerifiedAuthEmail()
        && request.resource.data.keys().hasAll([
          "uid",
          "name",
          "email",
          "role",
          "status",
          "schoolId",
          "photoURL",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "role",
          "status",
          "schoolId",
          "photoURL",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email == authEmail()
        && request.resource.data.role == "school_admin"
        && request.resource.data.status == "active"
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() > 0
        && (
          request.resource.data.photoURL == null
          || request.resource.data.photoURL is string
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(schoolPath(request.resource.data.schoolId))
        && getAfter(schoolPath(request.resource.data.schoolId)).data.primaryAdminId
          == userId
        && getAfter(schoolPath(request.resource.data.schoolId)).data.adminIds
          is list
        && getAfter(schoolPath(request.resource.data.schoolId)).data.adminIds.size()
          == 1
        && getAfter(schoolPath(request.resource.data.schoolId)).data.adminIds[0]
          == userId
        && getAfter(schoolPath(request.resource.data.schoolId)).data.createdBy
          == userId
        && getAfter(schoolPath(request.resource.data.schoolId)).data.createdAt
          == request.time
        && getAfter(schoolPath(request.resource.data.schoolId)).data.updatedAt
          == request.time
        && getAfter(schoolPath(request.resource.data.schoolId)).data.status
          == "active"
        && getAfter(schoolPath(request.resource.data.schoolId)).data.allowJoinRequests
          == true;
    }

    function isValidPendingTeacherProfileCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && hasVerifiedOrGoogleAuthEmail()
        && request.resource.data.keys().hasAll([
          "uid",
          "name",
          "email",
          "role",
          "status",
          "schoolId",
          "photoURL",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "name",
          "email",
          "role",
          "status",
          "schoolId",
          "photoURL",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email == authEmail()
        && request.resource.data.role == "teacher"
        && request.resource.data.status == "pending_approval"
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() > 0
        && (
          request.resource.data.photoURL == null
          || request.resource.data.photoURL is string
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(joinRequestPath(request.resource.data.schoolId, userId))
        && getAfter(joinRequestPath(request.resource.data.schoolId, userId)).data.userId
          == userId
        && getAfter(joinRequestPath(request.resource.data.schoolId, userId)).data.email
          == authEmail()
        && getAfter(joinRequestPath(request.resource.data.schoolId, userId)).data.requestedRole
          == "teacher"
        && getAfter(joinRequestPath(request.resource.data.schoolId, userId)).data.status
          == "pending"
        && getAfter(joinRequestPath(request.resource.data.schoolId, userId)).data.createdAt
          == request.time
        && getAfter(joinRequestPath(request.resource.data.schoolId, userId)).data.updatedAt
          == request.time;
    }

    function isValidTeacherReviewProfileUpdate(userId) {
      return isActiveSchoolAdmin()
        && resource.data.uid == userId
        && resource.data.role == "teacher"
        && resource.data.status == "pending_approval"
        && resource.data.schoolId == currentUser().schoolId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.photoURL == resource.data.photoURL
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt"
        ])
        && request.resource.data.status in ["active", "disabled"]
        && existsAfter(joinRequestPath(resource.data.schoolId, userId))
        && (
          (
            request.resource.data.status == "active"
            && getAfter(joinRequestPath(resource.data.schoolId, userId)).data.status
              == "approved"
          )
          || (
            request.resource.data.status == "disabled"
            && getAfter(joinRequestPath(resource.data.schoolId, userId)).data.status
              == "rejected"
          )
        )
        && getAfter(joinRequestPath(resource.data.schoolId, userId)).data.reviewedBy
          == request.auth.uid
        && getAfter(joinRequestPath(resource.data.schoolId, userId)).data.reviewedAt
          == request.time
        && getAfter(joinRequestPath(resource.data.schoolId, userId)).data.updatedAt
          == request.time;
    }

    function isValidSchoolUserRoleChange(userId) {
      return isActiveSchoolAdmin()
        && resource.data.uid == userId
        && resource.data.schoolId == currentUser().schoolId
        && resource.data.status == "active"
        && resource.data.role in ["teacher", "school_admin"]
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.status == resource.data.status
        && request.resource.data.role in ["teacher", "school_admin"]
        && request.resource.data.role != resource.data.role
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "updatedAt"
        ])
        && existsAfter(schoolPath(resource.data.schoolId))
        && getAfter(schoolPath(resource.data.schoolId)).data.adminIds is list
        && getAfter(schoolPath(resource.data.schoolId)).data.adminIds.size() > 0
        && (
          (
            request.resource.data.role == "school_admin"
            && getAfter(schoolPath(resource.data.schoolId)).data.adminIds.hasAny([
              userId
            ])
          )
          || (
            request.resource.data.role == "teacher"
            && !getAfter(schoolPath(resource.data.schoolId)).data.adminIds.hasAny([
              userId
            ])
          )
        );
    }

    function isValidSchoolPrimaryAdminRedemption(schoolId) {
      return signedIn()
        && request.resource.data.primaryAdminId == request.auth.uid
        && request.resource.data.adminIds is list
        && request.resource.data.adminIds.size() == 1
        && request.resource.data.adminIds[0] == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "adminIds",
          "primaryAdminId",
          "updatedAt"
        ])
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.role == "school_admin"
        && isPendingInvitationForAuth(
          getAfter(userPath(request.auth.uid)).data.invitationId
        )
        && isRedeemableSchoolAdminSchool(
          schoolId,
          getAfter(userPath(request.auth.uid)).data.invitationId
        )
        && isInviteeProfileAfter(
          request.auth.uid,
          schoolId,
          getAfter(userPath(request.auth.uid)).data.invitationId,
          "school_admin"
        )
        && isAcceptedInvitationAfter(
          getAfter(userPath(request.auth.uid)).data.invitationId,
          request.auth.uid
        );
    }

    function isValidInvitationRedemption(invitationId) {
      return signedIn()
        && hasVerifiedAuthEmail()
        && resource.data.token == invitationId
        && validInvitationRole(resource.data.role)
        && resource.data.status == "pending"
        && resource.data.expiresAt > request.time
        && authEmail() == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt",
          "acceptedAt",
          "acceptedBy"
        ])
        && request.resource.data.status == "accepted"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.acceptedBy == request.auth.uid
        && isPendingInvitationForAuth(invitationId)
        && isActiveInvitationSchool(resource.data.schoolId, invitationId)
        && isInviteeProfileAfter(
          request.auth.uid,
          resource.data.schoolId,
          invitationId,
          resource.data.role
        )
        && resource.data.role == "school_admin"
        && isRedeemableSchoolAdminSchool(resource.data.schoolId, invitationId)
        && isPrimaryAdminAfter(resource.data.schoolId, request.auth.uid)
        && isAcceptedInvitationAfter(invitationId, request.auth.uid);
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (
          request.auth.uid == userId
          || isActivePlatformAdmin()
          || isSchoolUserInOwnSchool()
          || isPendingTeacherProfileInOwnSchool()
          || isTeacherPeerInOwnSchool()
        );
      allow list: if isActivePlatformAdmin()
        || canListSchoolUsersInOwnSchool()
        || isTeacherPeerInOwnSchool();
      allow create: if isValidInviteeProfileCreate(userId)
        || isValidSelfServiceSchoolAdminProfileCreate(userId)
        || isValidPendingTeacherProfileCreate(userId);
      allow update: if isValidOwnProfileUpdate(userId)
        || isValidTeacherReviewProfileUpdate(userId)
        || isValidSchoolUserRoleChange(userId);
      allow delete: if false;
    }

    match /schools/{schoolId} {
      allow get: if isActivePlatformAdmin()
        || isOwnSchool(schoolId)
        || isPendingTeacherInOwnSchool(schoolId);
      allow list: if isActivePlatformAdmin();
      allow create: if (isActivePlatformAdmin() && isValidSchoolCreate())
        || isValidSelfServiceSchoolCreate(schoolId);
      allow update: if (
        isActivePlatformAdmin() && isValidSchoolUpdate()
      ) || isValidSchoolPrimaryAdminRedemption(schoolId)
        || isValidSchoolJoinRequestSettingUpdate(schoolId)
        || isValidSchoolRoleRosterUpdate(schoolId);
      allow delete: if false;
    }

    match /schools/{schoolId}/joinRequests/{userId} {
      allow get: if isOwnSchool(schoolId) || isOwnJoinRequest(userId);
      allow list: if isOwnSchool(schoolId);
      allow create: if isValidJoinRequestCreate(schoolId, userId);
      allow update: if isValidJoinRequestReview(schoolId, userId);
      allow delete: if false;
    }

    match /schools/{schoolId}/classes/{classId} {
      allow get, list: if isAcademicSetupReader(schoolId);
      allow create: if isValidAcademicItemCreate(schoolId);
      allow update: if isValidAcademicItemUpdate(schoolId);
      allow delete: if false;
    }

    match /schools/{schoolId}/subjects/{subjectId} {
      allow get, list: if isAcademicSetupReader(schoolId);
      allow create: if isValidAcademicItemCreate(schoolId);
      allow update: if isValidAcademicItemUpdate(schoolId);
      allow delete: if false;
    }

    match /schools/{schoolId}/classSubjects/{mappingId} {
      allow get, list: if isAcademicSetupReader(schoolId);
      allow create: if isValidClassSubjectMappingCreate(schoolId, mappingId);
      allow update: if false;
      allow delete: if isOwnSchool(schoolId);
    }

    match /schools/{schoolId}/teacherAssignments/{assignmentId} {
      allow get, list: if isTeacherAssignmentReader(schoolId);
      allow create: if isValidTeacherAssignmentCreate(schoolId, assignmentId);
      allow update: if false;
      allow delete: if isOwnSchool(schoolId);
    }

    match /schools/{schoolId}/questions/{questionId} {
      allow get, list: if canReadQuestion(schoolId, questionId);
      allow create: if isValidQuestionCreate(schoolId, questionId);
      allow update: if isValidQuestionUpdate(schoolId, questionId);
      allow delete: if false;
    }

    match /schools/{schoolId}/questionPapers/{paperId} {
      allow get, list: if canReadQuestionPaper(schoolId);
      allow create: if isValidQuestionPaperCreate(schoolId);
      allow update: if isValidQuestionPaperUpdate(schoolId);
      allow delete: if false;
    }

    match /schools/{schoolId}/questionShares/{shareId} {
      allow get, list: if canReadQuestionShare(schoolId);
      allow create: if isValidQuestionShareCreate(schoolId, shareId);
      allow update: if isValidQuestionShareUpdate(schoolId, shareId);
      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow get: if true;
      allow list: if isActivePlatformAdmin();
      allow create: if isValidInvitationCreate(invitationId);
      allow update: if isValidInvitationCancel()
        || isValidInvitationRedemption(invitationId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
